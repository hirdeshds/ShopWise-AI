{
  "manifest_version": 3,
  "name": "ShopWise AI",
  "version": "1.0.0",
  "description": "AI-powered price comparison across Indian e-commerce platforms — Amazon, Flipkart, Croma, Reliance Digital & Vijay Sales.",
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ShopWise AI — Find Best Deals",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.in/*",
        "*://*.flipkart.com/*",
        "*://*.croma.com/*",
        "*://*.reliancedigital.in/*",
        "*://*.vijaysales.com/*",
        "*://*.myntra.com/*",
        "*://*.meesho.com/*",
        "*://*.snapdeal.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://*.onrender.com/*",
    "https://*.vercel.app/*"
  ]
}
